}
.light-theme .navbar{
  background:rgba(248,250,252,.82);
  border-bottom-color:rgba(15,30,50,.08);
}
.light-theme .logo strong,
.light-theme .section-heading h2,
.light-theme .favorites-header h2,
.light-theme .settings-page-header h2,
.light-theme .home-feature-section h2,
.light-theme .settings-card-content h3,
.light-theme .game-body h3,
.light-theme .modal-content h2,
.light-theme .stat-card strong,
.light-theme .empty-box h3{
  color:#142033;
}
.light-theme nav button{
  color:#617188;
}
.light-theme nav button:hover,
.light-theme nav button.nav-active{
  color:#142033;
}
.light-theme .hero{
  background:transparent;
}
.light-theme .hero-bg{
  background:
    linear-gradient(90deg,#f8fafcf5 0%,#f8fafce0 42%,#f8fafc50 100%),
    radial-gradient(circle at 75% 50%,rgba(255,48,79,.1),transparent 28%);
}
.light-theme .hero h1{
  color:#142033;
}
.light-theme .hero h1 strong{
  background:linear-gradient(90deg,#142033,#d91e3c);
  background-clip:text;
  -webkit-background-clip:text;
}
.light-theme .hero-copy p,
.light-theme .section-heading p,
.light-theme .favorites-header p,
.light-theme .settings-page-header p{
  color:#64748a;
}
.light-theme .hero-card,
.light-theme .stat-card,
.light-theme .game-card,
.light-theme .favorites-header,
.light-theme .settings-card{
  background:linear-gradient(145deg,#fff,#eef3f8);
  border-color:rgba(15,30,50,.09);
  box-shadow:0 20px 50px rgba(25,50,80,.1);
}
.light-theme .game-body h3{
  color:#172338;
}
.light-theme .game-meta{
  color:#66788e;
}
.light-theme .game-platforms span{
  background:rgba(15,30,50,.045);
  color:#66788e;
}
.light-theme .details-btn{
  background:#edf2f7;
  color:#52657b;
}
.light-theme .search-box input,
.light-theme select{
  background:#fff;
  color:#26364b;
  border-color:rgba(15,30,50,.12);
}
.light-theme select option{
  background:#fff;
  color:#152033;
}
.light-theme .reset-btn,
.light-theme .pagination button{
  background:#fff;
  color:#64768c;
}
.light-theme .loading-box,
.light-theme .error-box,
.light-theme .empty-box{
  background:rgba(255,255,255,.65);
  border-color:rgba(15,30,50,.1);
}
.light-theme .loading-box strong,
.light-theme .empty-box h3{
  color:#172338;
}
.light-theme .settings-choice-grid button{
  background:rgba(15,30,50,.035);
  color:#61738a;
}
.light-theme .settings-choice-grid button.selected{
  color:#172338;
}
.light-theme .game-modal{
  background:#fff;
  border-color:rgba(15,30,50,.1);
}
.light-theme .modal-content h2{
  color:#172338;
}
.light-theme .modal-info div{
  background:#f5f7fa;
  border-color:rgba(15,30,50,.08);
}
.light-theme .modal-info strong{
  color:#26364a;
}
.light-theme .modal-description{
  color:#65778d;
}
.light-theme footer{
  background:#e9eef4;
  border-top-color:rgba(15,30,50,.08);
}
[dir="rtl"]{
  text-align:right;
}

/* V4 LIGHT THEME POLISH */
.light-theme body,
body:has(.light-theme){
  background:
    radial-gradient(circle at 100% 0%,rgba(255,48,79,.045),transparent 24%),
    radial-gradient(circle at 0% 20%,rgba(35,140,255,.04),transparent 25%),
    linear-gradient(180deg,#f7f9fb,#eef2f6 55%,#f7f9fb);
}
.light-theme .stat-card,
.light-theme .game-card,
.light-theme .settings-card,
.light-theme .favorites-header,
.light-theme .spotlight-side,
.light-theme .quick-card,
.light-theme .genre-tile{
  box-shadow:0 16px 45px rgba(32,55,80,.08);
}
.light-theme .controls{
  background:rgba(255,255,255,.82);
}
.light-theme .controls .search-box input,
.light-theme .controls select{
  background:#fff;
}
.light-theme .game-modal{
  background:linear-gradient(150deg,#fff,#f4f7fa);
}
